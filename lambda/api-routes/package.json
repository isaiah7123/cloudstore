{
  "name": "cloudstore-api",
  "version": "1.0.0",
  "description": "Cloudstore file API Lambda function",
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "build": "zip -r function.zip index.mjs node_modules",
    "deploy": "aws lambda update-function-code --function-name cloudstore-api --zip-file fileb://function.zip"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "aws-jwt-verify": "^4.0.1"
  }
}